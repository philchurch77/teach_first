# Django (production)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=1

# Local development
#
# DJANGO_DEBUG defaults to 0, so a deploy that forgets to set it fails closed
# instead of publishing tracebacks. That means local work has to opt in:
#
#   DJANGO_DEBUG=1
#
# Set it in your shell or your editor's run configuration. Without it,
# manage.py refuses to start because DJANGO_SECRET_KEY has no default outside
# DEBUG -- that is the intended behaviour, not a broken checkout.
#
# Do NOT set DJANGO_DEBUG=1 on the server. The deploy runs collectstatic, and
# with DEBUG on it would skip building the static manifest that DEBUG=0 then
# requires.
